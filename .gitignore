# Dependencies
/node_modules/

# Next.js build output
/.next/
/out/
/build/

# Netlify local state and deployment metadata
/.netlify/

# Local product/integration state (may contain encrypted credentials)
/.data/

# Local environment files. Keep only the safe template in version control.
.env
.env.*
!.env.example

# Local secrets and keys
*.pem
*.key

# Test output and coverage
/coverage/

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.log

# OS/editor files
.DS_Store
*.swp
*.swo

# Local backups created during dependency/security fixes
package.json.before-*
package-lock.json.before-*
