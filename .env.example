# Copy this file to .env.local for local development.
# Never put real API keys, OAuth secrets, or private keys in this template or in Git.
# For local development, generate SESSION_ENCRYPTION_KEY with:
#   openssl rand -base64 32

# App URL: localhost for local development; the full HTTPS origin on Netlify.
APP_BASE_URL=http://localhost:3000

# Required for encrypted provider integration state (Buffer/GitHub OAuth).
SESSION_ENCRYPTION_KEY=

# Optional: without an API key, Releasebuff uses its labelled non-AI fallback paths.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

# Optional: GitHub App integration for access to selected private repositories.
# Public repository URL scanning does not require these values.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Keep the PEM private key secret. For dotenv, use a single line with escaped \n sequences.
GITHUB_APP_PRIVATE_KEY=

# Optional: Buffer OAuth. For this public repository, register a Public client (no client secret) and leave BUFFER_CLIENT_SECRET blank.
# The redirect URI must exactly match the Buffer app settings. Buffer currently requires HTTPS, including for localhost.
# For Netlify use https://YOUR-SITE.netlify.app/api/buffer/callback. Leave blank until an HTTPS callback is registered.
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=
BUFFER_REDIRECT_URI=
BUFFER_SCOPES=account:read posts:write offline_access

# Optional Claude-directed explainer planning
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
